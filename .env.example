# ─── sadWatcher Configuration ─────────────────────────────────────────────────

# Database Path (default = rebecca)
DB_PATH=/var/lib/rebecca/db.sqlite3

# Check interval in seconds
CHECK_INTERVAL=5

# Xray ports whose connections should be killed (comma-separated)
BOUNCE_PORTS=8080,8880

# Log file path
LOG_FILE=/var/lib/sadWatcher/sadWatcher.log

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO